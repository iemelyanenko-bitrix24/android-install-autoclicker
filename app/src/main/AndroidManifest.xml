<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Разрешений не требуется: сервис доступности защищён собственным
        системным permission, доступ в сеть приложению не нужен.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".InstallClickerService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            exported, чтобы принимать broadcast от adb shell (он приходит из
            стороннего uid). Ресивер умеет только переключать локальный флаг.
        -->
        <receiver
            android:name=".ToggleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ru.installclicker.TOGGLE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
